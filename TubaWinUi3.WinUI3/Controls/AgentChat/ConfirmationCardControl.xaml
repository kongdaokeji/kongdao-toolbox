<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TubaWinUi3.Controls.AgentChat.ConfirmationCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TubaWinUi3.Controls.AgentChat"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            CornerRadius="10" BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="12,10">
        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE7BA;" FontSize="14"
                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                <TextBlock Text="需要确认的操作" FontSize="13" FontWeight="Bold" />
                <TextBlock Text="{x:Bind PendingCountText, Mode=OneWay}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ItemsControl x:Name="RequestList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="8" Padding="10,8" Margin="0,0,0,4">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="{Binding Glyph}"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Summary}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                           FontFamily="Cascadia Code, Consolas"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap" MaxLines="4"
                                           Visibility="{Binding HasDetailVisibility}" />
                                <TextBlock Text="{Binding ReasonText}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button Content="拒绝" FontSize="12" Padding="12,4" CornerRadius="6"
                                            Click="Reject_Click" Tag="{Binding Index}" />
                                    <Button Content="{Binding ConfirmButtonText}" FontSize="12" Padding="12,4" CornerRadius="6"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="Confirm_Click" Tag="{Binding Index}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="全部拒绝" FontSize="12" Padding="12,4" CornerRadius="6"
                        Click="RejectAll_Click" />
                <Button Content="全部确认" FontSize="12" Padding="12,4" CornerRadius="6"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="ConfirmAll_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
