<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TubaWinUi3.Controls.AgentChat.StepChainControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TubaWinUi3.Controls.AgentChat"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 步骤行模板（传统 Binding，兼容本项目 XAML 编译器配置） -->
        <DataTemplate x:Key="StepRowTemplate">
            <Grid Padding="4,3" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 运行指示 / 状态图标 -->
                <ProgressRing Width="14" Height="14" IsActive="{Binding IsRunning}"
                              Visibility="{Binding IsRunningVisibility}" VerticalAlignment="Center" />
                <FontIcon Grid.Column="0" FontSize="12" Glyph="{Binding StatusGlyph}"
                          Foreground="{Binding StatusBrush}"
                          Visibility="{Binding IsWaitingVisibility}" VerticalAlignment="Center" />

                <!-- 工具名 + 摘要 + 结果预览 -->
                <StackPanel Grid.Column="1" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="11" Glyph="{Binding ToolGlyph}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                   FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Summary}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding ResultPreview}" FontSize="11"
                               Foreground="{Binding StatusBrush}"
                               FontFamily="Cascadia Code, Consolas"
                               TextWrapping="Wrap" MaxLines="3"
                               Visibility="{Binding IsDoneVisibility}" />
                </StackPanel>

                <!-- 耗时 + 状态文字 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DurationText}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                               Foreground="{Binding StatusBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            CornerRadius="10" Padding="12,8" BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <StackPanel Spacing="4">
            <!-- 摘要头部（点击展开/折叠） -->
            <Button x:Name="HeaderButton" HorizontalAlignment="Stretch" Padding="4,3"
                    Background="Transparent" BorderThickness="0" CornerRadius="6"
                    Click="HeaderButton_Click">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="ChevronIcon" FontSize="11" Glyph="&#xE70D;"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                        <FontIcon.RenderTransform>
                            <RotateTransform />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                    <TextBlock x:Name="SummaryText" Grid.Column="1" FontSize="12"
                               FontWeight="Bold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- 步骤列表（折叠动画容器） -->
            <ItemsControl x:Name="StepList" MaxHeight="1200"
                          ItemTemplate="{StaticResource StepRowTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
