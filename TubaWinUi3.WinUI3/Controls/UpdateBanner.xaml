<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TubaWinUi3.Controls.UpdateBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Visibility="Collapsed">

    <Border
        x:Name="BannerBorder"
        Padding="16,8"
        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
        BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
        BorderThickness="0,0,0,1"
        CornerRadius="0">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
                Grid.Column="0"
                FontSize="16"
                VerticalAlignment="Center"
                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                Glyph="&#xE895;" />

            <TextBlock
                x:Name="BannerText"
                Grid.Column="1"
                VerticalAlignment="Center"

                FontSize="13"
                TextTrimming="CharacterEllipsis"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <ProgressBar
                x:Name="DownloadProgressBar"
                Grid.Column="1"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                Visibility="Collapsed"
                Maximum="100" />

            <Button
                x:Name="ActionButton"
                Grid.Column="2"
                VerticalAlignment="Center"
                Padding="12,4"
                MinHeight="28"

                FontSize="12"
                FontWeight="Bold"
                Click="ActionButton_Click"
                AutomationProperties.Name="开始更新" />

            <HyperlinkButton
                x:Name="ChangelogButton"
                Grid.Column="3"
                VerticalAlignment="Center"
                Padding="8,4"
                MinHeight="28"

                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Click="ChangelogButton_Click"
                AutomationProperties.Name="查看更新日志">
                查看更新日志
            </HyperlinkButton>

            <Button
                x:Name="CloseButton"
                Grid.Column="4"
                VerticalAlignment="Center"
                Width="28" Height="28"
                Padding="0"
                BorderThickness="0"
                Background="Transparent"
                Click="CloseButton_Click"
                AutomationProperties.Name="关闭更新提示">
                <FontIcon FontSize="12" Glyph="&#xE711;" />
            </Button>
        </Grid>
    </Border>
</UserControl>
