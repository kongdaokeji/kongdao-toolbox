<UserControl
    x:Class="TubaWinUi3.Controls.HealthGauge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Margin="10,0,10,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Canvas x:Name="GaugeCanvas" Width="220" Height="220" />

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,-30,0,0">
            <TextBlock HorizontalTextAlignment="Center" FontSize="20" Opacity="0.8">
                <Run Text="{x:Bind Label, Mode=OneWay}" />
            </TextBlock>
            <TextBlock HorizontalTextAlignment="Center" FontSize="24" FontWeight="Bold">
                <Run Text="{x:Bind StatusLabel, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
