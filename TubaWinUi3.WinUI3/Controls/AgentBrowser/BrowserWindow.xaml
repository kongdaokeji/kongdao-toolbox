<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TubaWinUi3.Controls.AgentBrowser.BrowserWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 浏览器工具栏：后退 / 前进 / 刷新 / 地址栏 -->
        <Grid Padding="10,8" ColumnSpacing="6"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Width="32" Height="32" Padding="0" CornerRadius="6"
                    Click="BackButton_Click" ToolTipService.ToolTip="后退">
                <FontIcon Glyph="&#xE72B;" FontSize="13" />
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="1" Width="32" Height="32" Padding="0"
                    CornerRadius="6" Click="ForwardButton_Click" ToolTipService.ToolTip="前进">
                <FontIcon Glyph="&#xE72A;" FontSize="13" />
            </Button>
            <Button x:Name="RefreshButton" Grid.Column="2" Width="32" Height="32" Padding="0"
                    CornerRadius="6" Click="RefreshButton_Click" ToolTipService.ToolTip="刷新">
                <FontIcon Glyph="&#xE72C;" FontSize="13" />
            </Button>

            <TextBox x:Name="AddressBox" Grid.Column="3" MinHeight="32"
                     PlaceholderText="输入网址后按 Enter"
                     VerticalContentAlignment="Center"
                     CornerRadius="8" Padding="10,4"
                     KeyDown="AddressBox_KeyDown" />

            <TextBlock x:Name="StatusText" Grid.Column="4" FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center" Margin="6,0,0,0" Text="就绪" />
        </Grid>

        <WebView2 x:Name="Web" Grid.Row="1" />
    </Grid>
</Window>
