<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.TestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TubaWinUi3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="40,32,40,32">
        <StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">

            <TextBlock FontSize="28" FontWeight="Bold" Text="组件测试" />
            <TextBlock Opacity="0.7" FontSize="14" Text="预览 HealthGauge 仪表盘与 SparklineGraph 图表组件" />

            <TextBlock FontSize="20" FontWeight="Bold" Text="HealthGauge 健康度仪表盘" />
            <Slider x:Name="GaugeValueSlider" Minimum="0" Maximum="100" Value="95" StepFrequency="1" Width="300" HorizontalAlignment="Left" />
            <controls:HealthGauge x:Name="TestGauge" Value="{x:Bind GaugeValueSlider.Value, Mode=OneWay}" Width="220" Height="220" HorizontalAlignment="Left" />

            <TextBlock FontSize="20" FontWeight="Bold" Text="SparklineGraph 折线面积图" />
            <controls:SparklineGraph x:Name="TestSparkline" Height="150" HorizontalAlignment="Stretch" />

            <TextBlock FontSize="20" FontWeight="Bold" Text="多个仪表盘对比" />
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <controls:HealthGauge x:Name="Gauge1" Value="15" Width="160" Height="160" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Opacity="0.7" Text="15%" />
                </StackPanel>
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <controls:HealthGauge x:Name="Gauge2" Value="45" Width="160" Height="160" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Opacity="0.7" Text="45%" />
                </StackPanel>
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <controls:HealthGauge x:Name="Gauge3" Value="75" Width="160" Height="160" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Opacity="0.7" Text="75%" />
                </StackPanel>
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <controls:HealthGauge x:Name="Gauge4" Value="98" Width="160" Height="160" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Opacity="0.7" Text="98%" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
