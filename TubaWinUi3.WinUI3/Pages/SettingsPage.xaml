                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBorderStyle}">
                                            <FontIcon FontSize="18" Glyph="&#xE799;" />
                                        </Border>
