                                        <Grid Grid.Row="2" ColumnSpacing="16" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconBorderStyle}">
                                                <FontIcon FontSize="18" Glyph="&#xE774;" />
