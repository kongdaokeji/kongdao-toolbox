                                        <ToggleSwitch x:Name="HardwareMultiDeviceNewLineToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="HardwareMultiDeviceNewLineToggle_Toggled" />
                                    </Grid>
                                </Border>

