<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.HardwareDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="DetailRowStyle" TargetType="Grid">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="ColumnSpacing" Value="6" />
        </Style>

        <DataTemplate x:Key="DetailRowTemplate">
            <Grid Style="{StaticResource DetailRowStyle}" Tapped="DetailItem_Tapped" IsTapEnabled="True" ToolTipService.ToolTip="点击复制">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="12" Opacity="1.0" Text="{Binding Label}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Width="1" Height="12" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" FontSize="12" FontWeight="Bold" Text="{Binding Value}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="Transparent">
        <ScrollViewer Padding="28,12,28,12" VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="LayoutRoot"
                Spacing="8"
                MaxWidth="1200"
                HorizontalAlignment="Stretch">

                <!-- Header -->
                <Grid ColumnSpacing="10" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Padding="10,5"
                        Click="BackButton_Click"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE72B;" />
                            <TextBlock FontSize="14" Text="返回" />
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock FontSize="26" FontWeight="Bold" Text="详细信息" />
                            <Border
                                x:Name="CpuzBadge"
                                Visibility="Collapsed"
                                Padding="8,2"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                Margin="0,4,0,0">
                                <Border.Background>
                                    <SolidColorBrush Color="#2600C864" />
                                </Border.Background>
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="#FF00C864"
                                    Text="CPU-Z" />
                            </Border>
                        </StackPanel>
                        <TextBlock FontSize="13" Opacity="1.0" Text="完整硬件参数一览" />
                    </StackPanel>
                    <Button
                        x:Name="ExportButton"
                        Grid.Column="2"
                        Padding="10,5"
                        Click="ExportButton_Click"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xEDE1;" />
                            <TextBlock FontSize="14" Text="导出" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="RefreshButton"
                        Grid.Column="3"
                        Padding="10,5"
                        Click="RefreshButton_Click"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="RefreshIcon" FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock FontSize="14" Text="刷新" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Cards container — populated dynamically in code-behind -->
                <Grid x:Name="CardsContainer" ColumnSpacing="8" RowSpacing="8" />

                <!-- Real-time monitoring section -->
                <StackPanel x:Name="RealtimeSection" Spacing="8" Margin="0,8,0,0">
                    <TextBlock FontSize="14" FontWeight="Bold" Text="实时信息" Margin="0,0,0,2" />

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource SectionCardStyle}" Grid.Column="0" Padding="12,10">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock FontSize="12" Opacity="0.7" Text="CPU" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CpuLoadText" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" Text="--" VerticalAlignment="Center" />
                                </Grid>
                                <lvc:CartesianChart x:Name="CpuChart" Height="80" Background="Transparent" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}" Grid.Column="1" Padding="12,10">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock FontSize="12" Opacity="0.7" Text="GPU" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GpuLoadText" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" Text="--" VerticalAlignment="Center" />
                                </Grid>
                                <lvc:CartesianChart x:Name="GpuChart" Height="80" Background="Transparent" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}" Grid.Column="2" Padding="12,10">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock FontSize="12" Opacity="0.7" Text="内存" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MemLoadText" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" Text="--" VerticalAlignment="Center" />
                                </Grid>
                                <lvc:CartesianChart x:Name="MemChart" Height="80" Background="Transparent" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}" Grid.Column="3" Padding="12,10">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock FontSize="12" Opacity="0.7" Text="硬盘" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="DiskReadText" FontSize="12" FontWeight="Bold" Text="--" />
                                        <TextBlock FontSize="10" Opacity="0.5" Text="/" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DiskWriteText" FontSize="12" FontWeight="Bold" Text="--" />
                                    </StackPanel>
                                </Grid>
                                <lvc:CartesianChart x:Name="DiskChart" Height="80" Background="Transparent" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="BatteryCard" Style="{StaticResource SectionCardStyle}" Grid.Column="4" Padding="12,10" Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock FontSize="12" Opacity="0.7" Text="电池" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="BatPercentText" FontSize="18" FontWeight="Bold" Text="--" />
                                        <TextBlock x:Name="BatPowerText" FontSize="11" Opacity="0.7" Text="" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <lvc:CartesianChart x:Name="BatChart" Height="80" Background="Transparent" />
                            </StackPanel>
                        </Border>

                    </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            x:Name="LoadingRing"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False"
            Visibility="Collapsed" />

        <InfoBar
            x:Name="StatusBar"
            Margin="28"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Page>
