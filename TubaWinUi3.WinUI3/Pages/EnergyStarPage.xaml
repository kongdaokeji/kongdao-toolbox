<?xml version="1.0" encoding="utf-8" ?>
<!--
    EnergyStarWindow — standalone window UI for the EcoQoS efficiency-mode tool.
    UI design ported from EnergyStarX (https://github.com/JasonWei512/EnergyStarX)
    Copyright 2022 Bingxing Wang — MIT licensed (see Services/EnergyStar/LICENSE.txt).
-->
<Page
    x:Class="TubaWinUi3.Pages.EnergyStarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Padding="24,20,24,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8">
                <FontIcon FontSize="20" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE83F;" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock FontSize="22" FontWeight="Bold" Text="后台节流省电神器" />
                    <Border x:Name="StatusBadge" Padding="8,2" CornerRadius="10" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusBadgeText" FontSize="11" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="StatusText" Opacity="0.8" FontSize="12" IsTextSelectionEnabled="True" />
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="2" Click="CloseButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    <TextBlock Text="返回" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,0,24,24">
            <StackPanel Spacing="14" MaxWidth="780">

                <!-- 概述卡片 -->
                <Border BorderThickness="1" CornerRadius="6" Padding="16" BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="16" Glyph="&#xE83F;" />
                            <TextBlock FontSize="15" FontWeight="Bold" Text="EcoQoS 效率模式 (Energy Star X 内核)" />
                        </StackPanel>
                        <TextBlock Opacity="0.8" FontSize="13" TextWrapping="Wrap">
                            通过 Windows 11 Process Power Throttling API 节流后台进程以提升电池续航与散热；前台应用不会被节流以保证体验。任务管理器的“状态”列会对节流的后台进程显示绿色叶子图标。
                        </TextBlock>
                        <TextBlock x:Name="AdminWarningText" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                            <FontIcon FontSize="11" Glyph="&#xE71B;" Opacity="0.6" />
                            <TextBlock FontSize="11" Opacity="0.6">
                                <Run Text="源自开源项目 " /><Run FontWeight="Bold" Text="EnergyStarX" />
                                <Hyperlink NavigateUri="https://github.com/JasonWei512/EnergyStarX">
                                    <Run Text="github.com/JasonWei512/EnergyStarX" />
                                </Hyperlink>
                                <Run Text=" (MIT License, © 2022 Bingxing Wang)" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 开关 -->
                <Border BorderThickness="1" CornerRadius="6" Padding="16" BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleSwitch x:Name="MainToggle" Header="启用效率模式" OnContent="开启" OffContent="停止" Toggled="MainToggle_Toggled" />
                            <Button x:Name="PauseButton" Click="PauseButton_Click" Margin="16,0,0,0" ToolTipService.ToolTip="暂停节流但保持进程列表加载与启动项设置">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="PauseButtonIcon" Glyph="&#xE769;" FontSize="12" />
                                    <TextBlock x:Name="PauseButtonText" Text="暂停节流" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <InfoBar x:Name="ToastBar" IsClosable="True" IsOpen="False" />
                    </StackPanel>
                </Border>

                <!-- 选项 -->
                <Border BorderThickness="1" CornerRadius="6" Padding="16" BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="14" FontWeight="Bold" Text="节流选项" />

                        <ToggleSwitch x:Name="ThrottleWhenPluggedInToggle"
                                      Header="插电时也节流所有后台进程"
                                      OffContent="仅节流黑名单"
                                      OnContent="节流除白名单外全部"
                                      Toggled="ThrottleWhenPluggedInToggle_Toggled" />

                        <StackPanel Spacing="4">
                            <ToggleSwitch x:Name="RunAtStartupToggle"
                                          Header="开机自启 (管理员计划任务)"
                                          OnContent="已启用"
                                          OffContent="未启用"
                                          Toggled="RunAtStartupToggle_Toggled" />
                            <TextBlock x:Name="RunAtStartupHint" Opacity="0.6" FontSize="11" Margin="0,-4,0,0" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 白名单编辑器 -->
                <Border BorderThickness="1" CornerRadius="6" Padding="16" BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="14" FontWeight="Bold" Text="进程白名单" />
                                <TextBlock Opacity="0.7" FontSize="11" Text="白名单中的进程绝不会被节流 (一行一个)" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="ToggleWhitelistEdit_Click" x:Name="ToggleWhitelistEditButton">
                                <TextBlock x:Name="ToggleWhitelistEditText" Text="编辑" />
                            </Button>
                            <Button Grid.Column="2" Click="SaveWhitelist_Click" x:Name="SaveWhitelistButton" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74E;" FontSize="12" /><TextBlock Text="保存" /></StackPanel>
                            </Button>
                            <Button Grid.Column="3" Click="RestoreWhitelist_Click" ToolTipService.ToolTip="还原为默认白名单">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            </Button>
                        </Grid>
                        <TextBox x:Name="WhitelistEditor"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 IsSpellCheckEnabled="False"
                                 MinHeight="180"
                                 MaxHeight="320"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- 黑名单编辑器 -->
                <Border BorderThickness="1" CornerRadius="6" Padding="16" BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="14" FontWeight="Bold" Text="进程黑名单" />
                                <TextBlock Opacity="0.7" FontSize="11" Text="黑名单中的进程始终被节流, 即使在插电时 (一行一个)" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="ToggleBlacklistEdit_Click" x:Name="ToggleBlacklistEditButton">
                                <TextBlock x:Name="ToggleBlacklistEditText" Text="编辑" />
                            </Button>
                            <Button Grid.Column="2" Click="SaveBlacklist_Click" x:Name="SaveBlacklistButton" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74E;" FontSize="12" /><TextBlock Text="保存" /></StackPanel>
                            </Button>
                            <Button Grid.Column="3" Click="RestoreBlacklist_Click" ToolTipService.ToolTip="还原为默认黑名单">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            </Button>
                        </Grid>
                        <TextBox x:Name="BlacklistEditor"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 IsSpellCheckEnabled="False"
                                 MinHeight="120"
                                 MaxHeight="260"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- 活动日志 -->
                <Border BorderThickness="1" CornerRadius="6" Padding="16" BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="14" FontWeight="Bold" Text="活动日志" />
                            <Button Grid.Column="1" Click="ClearLog_Click" ToolTipService.ToolTip="清空日志"><FontIcon Glyph="&#xE74D;" FontSize="12" /></Button>
                        </Grid>
                        <Border BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="1" Padding="8" CornerRadius="4">
                            <ScrollViewer x:Name="LogScrollViewer" Height="140" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
