<Page
    x:Class="TubaWinUi3.Pages.DisplayColorConfirmationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource LayerFillColorDefaultBrush}"
    KeyDown="Confirmation_KeyDown">
    <Grid Padding="24">
        <Border MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="32">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="680">
                <StackPanel Spacing="24">
                    <FontIcon Glyph="&#xE7F4;" FontSize="40" HorizontalAlignment="Left"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <StackPanel Spacing="8">
                        <TextBlock Text="保留这次屏幕调整？" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DisplayName" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Spacing="12">
                        <TextBlock Text="观察下面的色块与灰阶，确认画面看起来正常。" TextWrapping="Wrap"/>
                        <Grid Height="48" ColumnSpacing="4" AutomationProperties.Name="白、红、绿、蓝、灰色参考色块">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Background="White"/><Border Grid.Column="1" Background="Red"/>
                            <Border Grid.Column="2" Background="#FF00FF00"/><Border Grid.Column="3" Background="Blue"/>
                            <Border Grid.Column="4" Background="#FF808080"/>
                        </Grid>
                        <Border Height="24" AutomationProperties.Name="黑到白的灰阶渐变">
                            <Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="Black" Offset="0"/><GradientStop Color="White" Offset="1"/></LinearGradientBrush></Border.Background>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="Countdown" Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextWrapping="Wrap" AutomationProperties.AutomationId="DisplayColorCountdown"/>
                        <ProgressBar x:Name="TimeRemaining" Minimum="0" Maximum="20" Value="20"
                                     AutomationProperties.Name="距离自动恢复的剩余时间"/>
                        <TextBlock Text="不操作将自动恢复。按 Esc 或关闭此窗口也会恢复原状。"
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button x:Name="KeepButton" Content="保留效果" Click="Keep_Click"
                                HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="DisplayKeepColor"/>
                        <Button Grid.Column="1" Content="恢复原状" Click="Restore_Click"
                                HorizontalAlignment="Stretch" AutomationProperties.AutomationId="DisplayCancelColor"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
