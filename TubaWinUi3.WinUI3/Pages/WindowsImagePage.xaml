<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.WindowsImagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="24,20,24,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8">
                <FontIcon FontSize="20" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE896;" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock FontSize="22" FontWeight="Bold" Text="Windows 镜像下载" />
                <TextBlock Opacity="1.0" FontSize="12" Text="原版系统镜像下载，支持 ESD 转 ISO（需 UltraISO）" />
            </StackPanel>
        </Grid>

        <TeachingTip x:Name="QueueTeachingTip"
                      IsLightDismissEnabled="True"
                      PreferredPlacement="Bottom"
                      CloseButtonContent="知道了" />

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,0,24,24">
            <StackPanel Spacing="14">
                <InfoBar x:Name="StatusInfoBar" IsClosable="True" IsOpen="False" />

                <Pivot x:Name="SourcePivot" SelectedIndex="0" SelectionChanged="SourcePivot_SelectionChanged">
                    <PivotItem Header="微软官方下载">
                        <StackPanel Spacing="14" Padding="0,8,0,0">
                            <InfoBar IsOpen="True" IsClosable="False" Title="微软官方下载说明" Severity="Informational">
                                <TextBlock Text="从微软官方服务器获取 ISO 下载链接。需选择版本和语言后获取链接，链接 24 小时内有效。部分地区可能需要 VPN。&#x0a;注意：LTSC、企业版、教育版、IoT、Server 等版本请使用「UUP Dump」标签页获取。" TextWrapping="Wrap" />
                            </InfoBar>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="MsEditionCombo" MinWidth="320" PlaceholderText="选择 Windows 版本..." HorizontalAlignment="Stretch" SelectionChanged="MsEditionCombo_SelectionChanged" />
                                <ComboBox x:Name="MsLangCombo" Grid.Column="1" MinWidth="180" PlaceholderText="选择语言..." IsEnabled="False" />
                            </Grid>

                            <Button x:Name="MsFetchBtn" HorizontalAlignment="Stretch" Click="MsFetchBtn_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="获取官方下载链接" />
                                </StackPanel>
                            </Button>

                            <ProgressRing x:Name="MsProgressRing" Width="28" Height="28" HorizontalAlignment="Center" Visibility="Collapsed" IsActive="True" />
                            <TextBlock x:Name="MsStatusText" HorizontalAlignment="Center" FontSize="12" Opacity="1.0" Visibility="Collapsed" Text="" />

                            <StackPanel x:Name="MsResultPanel" Spacing="10" Visibility="Collapsed">
                                <Border Padding="16" CornerRadius="8">
                                    <Border.Background>
                                        <SolidColorBrush Color="{ThemeResource SubtleFillColorSecondary}" />
                                    </Border.Background>
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="MsResultTitle" FontSize="14" FontWeight="Bold" />
                                        <TextBlock x:Name="MsResultInfo" FontSize="12" Opacity="1.0" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="MsDownloadBtn" Click="MsDownloadBtn_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE896;" FontSize="12" />
                                                    <TextBlock Text="加入下载队列" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="MsOpenBrowserBtn" Click="MsOpenBrowserBtn_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE774;" FontSize="12" />
                                                    <TextBlock Text="浏览器下载" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="MsCopyLinkBtn" Click="MsCopyLinkBtn_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                    <TextBlock Text="复制链接" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </PivotItem>

                    <PivotItem Header="社区镜像源">
                        <StackPanel Spacing="14" Padding="0,8,0,0">
                            <InfoBar IsOpen="True" IsClosable="False" Title="社区镜像风险提醒" Severity="Warning">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="Bold" Text="来源：GitHub ILLKX/Windows 社区项目" /><LineBreak />
                                    <Run FontWeight="Bold" Foreground="Red" Text="⚠ 风险提醒：" />社区镜像非微软官方提供，虽经社区验证，但无法保证文件完整性与安全性。建议下载后校验 SHA256，或优先使用"微软官方下载"标签页获取原版镜像。
                                </TextBlock>
                            </InfoBar>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索 Windows 版本、语言..." MinWidth="240" QueryIcon="Find" TextChanged="SearchBox_TextChanged" />
                                <ComboBox x:Name="CategoryCombo" Grid.Column="1" MinWidth="140" SelectedIndex="0" SelectionChanged="CategoryCombo_SelectionChanged">
                                    <x:String>全部</x:String>
                                    <x:String>Desktop Windows</x:String>
                                    <x:String>Windows Server</x:String>
                                </ComboBox>
                                <ComboBox x:Name="LangCombo" Grid.Column="2" MinWidth="120" SelectedIndex="0" SelectionChanged="LangCombo_SelectionChanged">
                                    <x:String>全部语言</x:String>
                                    <x:String>简体中文</x:String>
                                    <x:String>English</x:String>
                                </ComboBox>
                                <Button x:Name="RefreshBtn" Grid.Column="3" Click="RefreshBtn_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                        <TextBlock Text="刷新" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border x:Name="HeaderBorder" Padding="12,6,12,6" CornerRadius="6,6,0,0">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="11" FontWeight="Bold" Opacity="1.0" Text="版本" MinWidth="60" />
                                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="Bold" Opacity="1.0" Text="文件名" />
                                    <TextBlock Grid.Column="2" FontSize="11" FontWeight="Bold" Opacity="1.0" Text="大小" MinWidth="60" />
                                    <TextBlock Grid.Column="3" FontSize="11" FontWeight="Bold" Opacity="1.0" Text="语言" MinWidth="70" />
                                    <TextBlock Grid.Column="4" FontSize="11" FontWeight="Bold" Opacity="1.0" Text="架构" MinWidth="44" />
                                    <TextBlock Grid.Column="5" FontSize="11" FontWeight="Bold" Opacity="1.0" Text="操作" MinWidth="120" />
                                </Grid>
                            </Border>

                            <Border x:Name="ListBorder" BorderThickness="1" CornerRadius="0,0,6,6">
                                <StackPanel x:Name="ListContainer" />
                            </Border>

                            <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" Spacing="8" Padding="0,40,0,40" Visibility="Collapsed">
                                <ProgressRing x:Name="LoadingRing" Width="36" Height="36" IsActive="True" />
                                <TextBlock FontSize="13" Opacity="1.0" Text="正在加载镜像列表..." />
                            </StackPanel>

                            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" Spacing="8" Padding="0,40,0,40" Visibility="Collapsed">
                                <FontIcon Glyph="&#xE894;" FontSize="32" Opacity="1.0" />
                                <TextBlock FontSize="13" Opacity="1.0" Text="没有找到匹配的镜像" />
                            </StackPanel>
                        </StackPanel>
                    </PivotItem>
                    <PivotItem Header="UUP Dump">
                        <StackPanel Spacing="14" Padding="0,8,0,0">
                            <InfoBar IsOpen="True" IsClosable="False" Title="UUP Dump 说明" Severity="Informational">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="Bold" Text="来源：uupdump.net" /><LineBreak />
                                    <Run Text="从 Windows Update 服务器下载 UUP 文件并转换为 ISO。支持最新 Insider 版本、自定义构建、虚拟版本集成等功能。" />
                                </TextBlock>
                            </InfoBar>

                            <Pivot x:Name="UupSubPivot" SelectedIndex="0">
                                <PivotItem Header="快速获取">
                                    <StackPanel Spacing="14" Padding="0,8,0,0">
                                        <TextBlock FontSize="13" Opacity="1.0" Text="选择渠道和架构，直接获取最新构建版本：" />
                                        <GridView x:Name="UupQuickGrid" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="UupQuickGrid_ItemClick">
                                            <GridView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="12,8" CornerRadius="6" BorderThickness="1" Margin="4">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{ThemeResource SubtleFillColorSecondary}" />
                                                        </Border.Background>
                                                        <StackPanel Spacing="4">
                                                            <TextBlock FontSize="13" FontWeight="Bold" Text="{Binding DisplayName}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                        <ProgressRing x:Name="UupQuickProgress" Width="28" Height="28" HorizontalAlignment="Center" Visibility="Collapsed" IsActive="True" />
                                    </StackPanel>
                                </PivotItem>

                                <PivotItem Header="搜索已知构建">
                                    <StackPanel Spacing="14" Padding="0,8,0,0">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <AutoSuggestBox x:Name="UupSearchBox" PlaceholderText="搜索构建版本号，如 26100.1..." QueryIcon="Find" />
                                            <ComboBox x:Name="UupCategoryCombo" Grid.Column="1" MinWidth="160" SelectedIndex="0" SelectionChanged="UupCategoryCombo_SelectionChanged">
                                                <x:String>全部</x:String>
                                                <x:String>Canary</x:String>
                                                <x:String>Windows 11 24H2+</x:String>
                                                <x:String>Windows 11 23H2</x:String>
                                                <x:String>Windows 11 22H2</x:String>
                                                <x:String>Windows 11 21H2</x:String>
                                                <x:String>Windows 10</x:String>
                                                <x:String>Windows Server</x:String>
                                            </ComboBox>
                                            <Button x:Name="UupSearchBtn" Grid.Column="2" Click="UupSearchBtn_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE721;" FontSize="12" />
                                                    <TextBlock Text="搜索" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <ProgressRing x:Name="UupSearchProgress" Width="28" Height="28" HorizontalAlignment="Center" Visibility="Collapsed" IsActive="True" />
                                    </StackPanel>
                                </PivotItem>

                                <PivotItem Header="自定义构建">
                                    <StackPanel Spacing="14" Padding="0,8,0,0">
                                        <TextBlock FontSize="13" Opacity="1.0" Text="从 Windows Update 服务器查找指定构建版本：" />
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="UupBuildNumber" PlaceholderText="构建号，如 26100.1" />
                                            <ComboBox x:Name="UupNewArchCombo" Grid.Column="1" MinWidth="100" SelectedIndex="0">
                                                <x:String>amd64</x:String>
                                                <x:String>x86</x:String>
                                                <x:String>arm64</x:String>
                                            </ComboBox>
                                            <ComboBox x:Name="UupNewRingCombo" Grid.Column="2" MinWidth="120" SelectedIndex="4">
                                                <x:String>Canary</x:String>
                                                <x:String>WIF</x:String>
                                                <x:String>WIS</x:String>
                                                <x:String>RP</x:String>
                                                <x:String>Retail</x:String>
                                            </ComboBox>
                                            <ComboBox x:Name="UupNewSkuCombo" Grid.Column="3" MinWidth="160" SelectedIndex="1">
                                                <ComboBoxItem Content="Windows 家庭版 (101)" Tag="101" />
                                                <ComboBoxItem Content="Windows 专业版 (48)" Tag="48" />
                                                <ComboBoxItem Content="Windows 教育版 (121)" Tag="121" />
                                                <ComboBoxItem Content="Windows 企业版 (4)" Tag="4" />
                                                <ComboBoxItem Content="Windows 企业评估版 (72)" Tag="72" />
                                                <ComboBoxItem Content="Windows 11 IoT 企业版 (188)" Tag="188" />
                                                <ComboBoxItem Content="Windows 11 IoT 企业版订阅 (191)" Tag="191" />
                                                <ComboBoxItem Content="Windows 11 企业多会话版 (175)" Tag="175" />
                                                <ComboBoxItem Content="Windows 11 专业教育版 (164)" Tag="164" />
                                                <ComboBoxItem Content="Windows 11 专业工作站版 (161)" Tag="161" />
                                                <ComboBoxItem Content="Windows 11 SE (190)" Tag="190" />
                                                <ComboBoxItem Content="Windows 10/11 LTSC (125)" Tag="125" />
                                                <ComboBoxItem Content="Windows 10/11 LTSC 评估 (129)" Tag="129" />
                                                <ComboBoxItem Content="Windows 10 IoT 企业版 (183)" Tag="183" />
                                                <ComboBoxItem Content="Windows 10 企业版 LTSB (86)" Tag="86" />
                                                <ComboBoxItem Content="Windows 10 企业版 LTSB 评估 (87)" Tag="87" />
                                                <ComboBoxItem Content="Windows Team (119)" Tag="119" />
                                                <ComboBoxItem Content="Server 标准 (7)" Tag="7" />
                                                <ComboBoxItem Content="Server 数据中心 (8)" Tag="8" />
                                                <ComboBoxItem Content="Server 标准评估 (80)" Tag="80" />
                                                <ComboBoxItem Content="Server 数据中心评估 (81)" Tag="81" />
                                                <ComboBoxItem Content="Azure Stack HCI (406)" Tag="406" />
                                            </ComboBox>
                                        </Grid>
                                        <Button x:Name="UupFetchBuildBtn" HorizontalAlignment="Stretch" Click="UupFetchBuildBtn_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                                <TextBlock Text="查找构建" />
                                            </StackPanel>
                                        </Button>
                                        <ProgressRing x:Name="UupNewBuildProgress" Width="28" Height="28" HorizontalAlignment="Center" Visibility="Collapsed" IsActive="True" />
                                    </StackPanel>
                                </PivotItem>
                            </Pivot>

                            <Border x:Name="UupBuildHeaderBorder" Padding="12,6,12,6" CornerRadius="6,6,0,0" Visibility="Collapsed">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="11" FontWeight="Bold" Opacity="1.0" Text="构建版本" />
                                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="Bold" Opacity="1.0" Text="架构" MinWidth="50" />
                                    <TextBlock Grid.Column="2" FontSize="11" FontWeight="Bold" Opacity="1.0" Text="渠道" MinWidth="80" />
                                    <TextBlock Grid.Column="3" FontSize="11" FontWeight="Bold" Opacity="1.0" Text="分类" MinWidth="100" />
                                    <TextBlock Grid.Column="4" FontSize="11" FontWeight="Bold" Opacity="1.0" Text="操作" MinWidth="80" />
                                </Grid>
                            </Border>

                            <Border x:Name="UupBuildListBorder" BorderThickness="1" CornerRadius="0,0,6,6" Visibility="Collapsed">
                                <StackPanel x:Name="UupBuildListContainer" />
                            </Border>

                            <StackPanel x:Name="UupBuildLoadingPanel" HorizontalAlignment="Center" Spacing="8" Padding="0,30,0,30" Visibility="Collapsed">
                                <ProgressRing x:Name="UupBuildLoadingRing" Width="36" Height="36" IsActive="True" />
                                <TextBlock FontSize="13" Opacity="1.0" Text="正在获取构建列表..." />
                            </StackPanel>

                            <StackPanel x:Name="UupBuildEmptyPanel" HorizontalAlignment="Center" Spacing="8" Padding="0,30,0,30" Visibility="Collapsed">
                                <FontIcon Glyph="&#xE894;" FontSize="32" Opacity="1.0" />
                                <TextBlock FontSize="13" Opacity="1.0" Text="没有找到匹配的构建" />
                            </StackPanel>

                            <TextBlock x:Name="UupBuildCountText" FontSize="12" Opacity="1.0" Visibility="Collapsed" />
                        </StackPanel>
                    </PivotItem>
                </Pivot>
            </StackPanel>
        </ScrollViewer>

        <ContentDialog x:Name="UupLanguageDialog" Title="选择语言" CloseButtonText="取消" PrimaryButtonText="下一步" DefaultButton="Primary" PrimaryButtonClick="UupLanguageDialog_PrimaryButtonClick">
            <StackPanel Spacing="12" MinWidth="400">
                <TextBlock x:Name="UupLangBuildInfo" FontSize="12" Opacity="1.0" TextWrapping="Wrap" />
                <ProgressRing x:Name="UupLangProgress" Width="28" Height="28" HorizontalAlignment="Center" Visibility="Collapsed" IsActive="True" />
                <ListView x:Name="UupLangListView" SelectionMode="Single" MaxHeight="350" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="UupEditionDialog" Title="选择版本" CloseButtonText="取消" PrimaryButtonText="生成下载" DefaultButton="Primary" PrimaryButtonClick="UupEditionDialog_PrimaryButtonClick">
            <ScrollViewer MaxHeight="500" MinWidth="500">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="UupEditionBuildInfo" FontSize="12" Opacity="1.0" TextWrapping="Wrap" />
                    <ProgressRing x:Name="UupEditionProgress" Width="28" Height="28" HorizontalAlignment="Center" Visibility="Collapsed" IsActive="True" />
                    <TextBlock FontSize="13" FontWeight="Bold" Text="基础版本" Visibility="{x:Bind UupBaseEditionPanel.Visibility}" />
                    <StackPanel x:Name="UupBaseEditionPanel" Spacing="6" />
                    <TextBlock x:Name="UupVirtualEditionLabel" FontSize="13" FontWeight="Bold" Text="虚拟版本（可选）" Visibility="Collapsed" />
                    <StackPanel x:Name="UupVirtualEditionPanel" Spacing="6" Visibility="Collapsed" />

                    <TextBlock FontSize="14" FontWeight="Bold" Text="下载方式" Margin="0,8,0,0" />
                    <ComboBox x:Name="UupDownloadMethodCombo" MinWidth="320" SelectedIndex="1" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="仅下载 UUP 文件集（需手动转换）" Tag="1" />
                                        <ComboBoxItem Content="下载并转换为 ISO（推荐）" Tag="2" />
                                        <ComboBoxItem Content="下载、集成虚拟版本并转换为 ISO" Tag="3" />
                                    </ComboBox>
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="提示" Margin="0,4,0,0">
                        <TextBlock Text="转换选项（更新、清理、.NET 3.5 等）可在下载后修改 ZIP 包内的 ConvertConfig.ini 文件。" TextWrapping="Wrap" FontSize="12" />
                    </InfoBar>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

    </Grid>
</Page>
