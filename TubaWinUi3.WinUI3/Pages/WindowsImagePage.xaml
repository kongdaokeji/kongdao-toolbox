<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.WindowsImagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:TubaWinUi3.Services"
    mc:Ignorable="d">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="24,20,24,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8">
                <FontIcon FontSize="20" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE896;" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock FontSize="22" FontWeight="Bold" Text="Windows 镜像下载" />
                <TextBlock Opacity="1.0" FontSize="12" Text="原版系统镜像下载，支持 ESD 转 ISO（需 UltraISO）" />
            </StackPanel>
        </Grid>

        <TeachingTip x:Name="QueueTeachingTip"
                      IsLightDismissEnabled="True"
                      PreferredPlacement="Bottom"
                      CloseButtonContent="知道了" />

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,0,24,24">
            <StackPanel Spacing="14">
                <InfoBar x:Name="StatusInfoBar" IsClosable="True" IsOpen="False" />

                <Pivot x:Name="SourcePivot" SelectedIndex="0" SelectionChanged="SourcePivot_SelectionChanged">
                    <PivotItem Header="微软官方下载">
                        <StackPanel Spacing="14" Padding="0,8,0,0">
                            <InfoBar IsOpen="True" IsClosable="False" Title="微软官方下载说明" Severity="Informational">
                                <TextBlock Text="从微软官方服务器获取 ISO 下载链接。需选择版本和语言后获取链接，链接 24 小时内有效。部分地区可能需要 VPN。&#x0a;注意：LTSC、企业版、教育版、IoT、Server 等版本请使用「UUP Dump」标签页获取。" TextWrapping="Wrap" />
                            </InfoBar>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="MsEditionCombo" MinWidth="320" PlaceholderText="选择 Windows 版本..." HorizontalAlignment="Stretch" SelectionChanged="MsEditionCombo_SelectionChanged" />
                                <ComboBox x:Name="MsLangCombo" Grid.Column="1" MinWidth="180" PlaceholderText="选择语言..." IsEnabled="False" />
                            </Grid>

                            <Button x:Name="MsFetchBtn" HorizontalAlignment="Stretch" Click="MsFetchBtn_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="获取官方下载链接" />
                                </StackPanel>
                            </Button>

                            <ProgressRing x:Name="MsProgressRing" Width="28" Height="28" HorizontalAlignment="Center" Visibility="Collapsed" IsActive="True" />
                            <TextBlock x:Name="MsStatusText" HorizontalAlignment="Center" FontSize="12" Opacity="1.0" Visibility="Collapsed" Text="" />

                            <StackPanel x:Name="MsResultPanel" Spacing="10" Visibility="Collapsed">
                                <Border Padding="16" CornerRadius="8">
                                    <Border.Background>
                                        <SolidColorBrush Color="{ThemeResource SubtleFillColorSecondary}" />
                                    </Border.Background>
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="MsResultTitle" FontSize="14" FontWeight="Bold" />
                                        <TextBlock x:Name="MsResultInfo" FontSize="12" Opacity="1.0" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="MsDownloadBtn" Click="MsDownloadBtn_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE896;" FontSize="12" />
                                                    <TextBlock Text="加入下载队列" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="MsOpenBrowserBtn" Click="MsOpenBrowserBtn_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE774;" FontSize="12" />
                                                    <TextBlock Text="浏览器下载" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="MsCopyLinkBtn" Click="MsCopyLinkBtn_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                    <TextBlock Text="复制链接" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </PivotItem>

                    <PivotItem Header="社区镜像源">
                        <StackPanel Spacing="14" Padding="0,8,0,0">
                            <InfoBar IsOpen="True" IsClosable="False" Title="社区镜像风险提醒" Severity="Warning">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="Bold" Text="来源：GitHub ILLKX/Windows 社区项目" /><LineBreak />
                                    <Run FontWeight="Bold" Foreground="Red" Text="⚠ 风险提醒：" />社区镜像非微软官方提供，虽经社区验证，但无法保证文件完整性与安全性。建议下载后校验 SHA256，或优先使用"微软官方下载"标签页获取原版镜像。
                                </TextBlock>
                            </InfoBar>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索 Windows 版本、语言..." MinWidth="240" QueryIcon="Find" TextChanged="SearchBox_TextChanged" />
                                <ComboBox x:Name="CategoryCombo" Grid.Column="1" MinWidth="140" SelectedIndex="0" SelectionChanged="CategoryCombo_SelectionChanged">
                                    <x:String>全部</x:String>
                                    <x:String>Desktop Windows</x:String>
                                    <x:String>Windows Server</x:String>
                                </ComboBox>
                                <ComboBox x:Name="LangCombo" Grid.Column="2" MinWidth="120" SelectedIndex="0" SelectionChanged="LangCombo_SelectionChanged">
                                    <x:String>全部语言</x:String>
                                    <x:String>简体中文</x:String>
                                    <x:String>English</x:String>
                                </ComboBox>
                                <Button x:Name="RefreshBtn" Grid.Column="3" Click="RefreshBtn_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                        <TextBlock Text="刷新" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border x:Name="HeaderBorder" Padding="12,6,12,6" CornerRadius="6,6,0,0">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="11" FontWeight="Bold" Opacity="1.0" Text="版本" MinWidth="60" />
                                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="Bold" Opacity="1.0" Text="文件名" />
                                    <TextBlock Grid.Column="2" FontSize="11" FontWeight="Bold" Opacity="1.0" Text="大小" MinWidth="60" />
                                    <TextBlock Grid.Column="3" FontSize="11" FontWeight="Bold" Opacity="1.0" Text="语言" MinWidth="70" />
                                    <TextBlock Grid.Column="4" FontSize="11" FontWeight="Bold" Opacity="1.0" Text="架构" MinWidth="44" />
                                    <TextBlock Grid.Column="5" FontSize="11" FontWeight="Bold" Opacity="1.0" Text="操作" MinWidth="120" />
                                </Grid>
                            </Border>

                            <Border x:Name="ListBorder" BorderThickness="1" CornerRadius="0,0,6,6">
                                <StackPanel x:Name="ListContainer" />
                            </Border>

                            <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" Spacing="8" Padding="0,40,0,40" Visibility="Collapsed">
                                <ProgressRing x:Name="LoadingRing" Width="36" Height="36" IsActive="True" />
                                <TextBlock FontSize="13" Opacity="1.0" Text="正在加载镜像列表..." />
                            </StackPanel>

                            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" Spacing="8" Padding="0,40,0,40" Visibility="Collapsed">
                                <FontIcon Glyph="&#xE894;" FontSize="32" Opacity="1.0" />
                                <TextBlock FontSize="13" Opacity="1.0" Text="没有找到匹配的镜像" />
                            </StackPanel>
                        </StackPanel>
                    </PivotItem>
                    <PivotItem Header="UUP Dump">
                        <StackPanel Spacing="14" Padding="0,8,0,0">
                            <InfoBar IsOpen="True" IsClosable="False" Title="UUP Dump 说明" Severity="Informational">
                                <TextBlock Text="从微软官方 Windows Update 服务器下载系统原始文件并自动转换为 ISO，文件直链全部来自微软官方 CDN。适合获取 Insider 预览版、指定版本号、企业版 / LTSC、Server 等官方下载页没有的镜像。" TextWrapping="Wrap" />
                            </InfoBar>

                            <!-- 第 1 步：选择系统版本 -->
                            <Border Padding="16,12,16,12" CornerRadius="8">
                                <Border.Background>
                                    <SolidColorBrush Color="{ThemeResource SubtleFillColorSecondary}" />
                                </Border.Background>
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="14" FontWeight="Bold" Text="1. 选择系统版本" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="UupChannelCombo" MinWidth="116" SelectedIndex="1" SelectionChanged="UupChannelCombo_SelectionChanged">
                                            <x:String>全部</x:String>
                                            <x:String>正式版</x:String>
                                            <x:String>预览体验版</x:String>
                                            <x:String>Server</x:String>
                                        </ComboBox>
                                        <ComboBox x:Name="UupArchCombo" Grid.Column="1" MinWidth="110" SelectedIndex="0" SelectionChanged="UupArchCombo_SelectionChanged" />
                                        <AutoSuggestBox x:Name="UupSearchBox" Grid.Column="2" PlaceholderText="搜索版本号或关键词，如 26100、24H2、LTSC" QueryIcon="Find" QuerySubmitted="UupSearchBox_QuerySubmitted" />
                                        <Button x:Name="UupSearchBtn" Grid.Column="3" Click="UupSearchBtn_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE721;" FontSize="12" />
                                                <TextBlock Text="搜索" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <ListView x:Name="UupBuildList" MaxHeight="232" SelectionMode="Single" SelectionChanged="UupBuildList_SelectionChanged">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="services:UupBuildInfo">
                                                <StackPanel Spacing="2" Padding="2,5,2,5">
                                                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind DetailsDisplay}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <StackPanel x:Name="UupBuildLoadingPanel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Visibility="Collapsed">
                                        <ProgressRing x:Name="UupBuildLoadingRing" Width="20" Height="20" IsActive="True" />
                                        <TextBlock FontSize="12" Opacity="0.8" VerticalAlignment="Center" Text="正在获取构建列表..." />
                                    </StackPanel>
                                    <TextBlock x:Name="UupBuildStatusText" FontSize="12" Opacity="0.8" TextWrapping="Wrap" Visibility="Collapsed" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- 第 2 步：选择语言和版本 -->
                            <Border Padding="16,12,16,12" CornerRadius="8">
                                <Border.Background>
                                    <SolidColorBrush Color="{ThemeResource SubtleFillColorSecondary}" />
                                </Border.Background>
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="14" FontWeight="Bold" Text="2. 选择语言和版本" />
                                    <TextBlock x:Name="UupSelectedBuildText" FontSize="12" Opacity="0.8" TextWrapping="Wrap" Text="请先在上方第 1 步中选择一个系统版本" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="语言" VerticalAlignment="Center" FontSize="13" />
                                        <ComboBox x:Name="UupLangCombo" MinWidth="280" DisplayMemberPath="DisplayName" SelectionChanged="UupLangCombo_SelectionChanged" IsEnabled="False" />
                                        <ProgressRing x:Name="UupLangProgress" Width="20" Height="20" Visibility="Collapsed" IsActive="True" />
                                    </StackPanel>
                                    <TextBlock Text="版本" FontSize="13" />
                                    <ProgressRing x:Name="UupEditionProgress" Width="20" Height="20" HorizontalAlignment="Left" Visibility="Collapsed" IsActive="True" />
                                    <RadioButtons x:Name="UupEditionRadio" MaxColumns="3" SelectionChanged="UupEditionRadio_SelectionChanged">
                                        <RadioButtons.ItemTemplate>
                                            <DataTemplate x:DataType="services:UupEditionInfo">
                                                <TextBlock Text="{x:Bind DisplayName}" FontSize="13" />
                                            </DataTemplate>
                                        </RadioButtons.ItemTemplate>
                                    </RadioButtons>
                                    <Expander x:Name="UupVirtualEditionExpander" Header="附加版本（虚拟版本，可选）" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Visibility="Collapsed">
                                        <StackPanel Spacing="8">
                                            <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                                                       Text="附加版本由所选基础版本的文件直接合成，同一次下载即可获得（无需额外流量）。例如需要企业版镜像：基础版本选「Windows 专业版」，再在这里勾选「企业版」。" />
                                            <StackPanel x:Name="UupVirtualEditionPanel" Spacing="4" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- 第 3 步：下载并转换为 ISO -->
                            <Border Padding="16,12,16,12" CornerRadius="8">
                                <Border.Background>
                                    <SolidColorBrush Color="{ThemeResource SubtleFillColorSecondary}" />
                                </Border.Background>
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="14" FontWeight="Bold" Text="3. 下载并转换为 ISO" />
                                    <TextBlock x:Name="UupSummaryText" FontSize="12" Opacity="0.85" TextWrapping="Wrap" Text="完成前两步后，这里会显示下载内容摘要。" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="保存位置" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="UupSaveLocationText" FontSize="12" Opacity="0.85" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                        <Button x:Name="UupBrowseDirBtn" Click="UupBrowseDirBtn_Click" Padding="10,4,10,4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                                                <TextBlock Text="更改" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="UupResetDirBtn" Click="UupResetDirBtn_Click" Padding="10,4,10,4" Visibility="Collapsed">
                                            <TextBlock Text="恢复默认" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button x:Name="UupStartBtn" Style="{ThemeResource AccentButtonStyle}" Click="UupStartBtn_Click" IsEnabled="False" Padding="20,8,20,8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                                <TextBlock Text="开始下载并转换为 ISO" />
                                            </StackPanel>
                                        </Button>
                                        <CheckBox x:Name="UupNoConvertCheck" Content="仅下载文件集，不转换 ISO" VerticalAlignment="Center" Checked="UupNoConvertCheck_Changed" Unchecked="UupNoConvertCheck_Changed" />
                                    </StackPanel>
                                    <Expander Header="转换选项（高级）" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Spacing="6">
                                            <CheckBox x:Name="UupOptAddUpdates" Content="集成更新（官网默认，推荐）" IsChecked="True" />
                                            <CheckBox x:Name="UupOptCleanup" Content="运行组件清理（减小体积，转换明显变慢）" />
                                            <CheckBox x:Name="UupOptNetFx3" Content="集成 .NET Framework 3.5" />
                                            <CheckBox x:Name="UupOptEsd" Content="使用 solid (ESD) 压缩（生成 install.esd，体积更小）" />
                                            <CheckBox x:Name="UupOptApps" Content="集成商店应用完整版（额外下载数百 MB，转换更慢）" />
                                        </StackPanel>
                                    </Expander>
                                    <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                                               Text="下载进度可在主页搜索框旁的下载按钮中查看；下载完成后自动弹出官方转换脚本窗口（DISM 过程约需 10~30 分钟），生成的 ISO 保存在上方保存位置的对应目录中。加入队列时会按上方选项生成包目录中的 ConvertConfig.ini，下载期间可随时手动编辑微调全部转换参数，转换脚本启动时以该文件为准。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </PivotItem>
                </Pivot>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
