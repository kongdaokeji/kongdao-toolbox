<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.OfficialWebsitesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="20,20,20,12" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8">
                <FontIcon FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE8F1;" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock FontSize="20" FontWeight="Bold" Text="常用官网" />
                <TextBlock FontSize="12" Opacity="0.7" Text="常用软件官方网站直达" />
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="2" Click="BackButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    <TextBlock Text="返回" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="12,12,12,8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="14" Opacity="0.6" VerticalAlignment="Center" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="搜索软件名称..." TextChanged="SearchBox_TextChanged" />
                    </Grid>
                </Border>

                <ScrollView Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavPanel" Spacing="4" Padding="12,0,12,12" />
                </ScrollView>
            </Grid>

            <Border Grid.Column="1" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Grid Grid.Column="2" Padding="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentCategoryText" FontSize="16" FontWeight="Bold" Text="游戏平台" VerticalAlignment="Center" />
                    <TextBlock x:Name="SiteCountText" Grid.Column="1" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                </Grid>

                <ListView
                    x:Name="SiteList"
                    Grid.Row="1"
                    IsItemClickEnabled="True"
                    SelectionMode="None"
                    Padding="0" />

                <Grid x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <FontIcon Glyph="&#xE721;" FontSize="64" Opacity="0.3" HorizontalAlignment="Center" />
                        <TextBlock FontSize="15" Opacity="0.6" Text="未找到匹配的网站" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
