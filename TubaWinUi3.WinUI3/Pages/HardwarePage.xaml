<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.HardwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Name="EntranceStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="HeaderPanel"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.4"
                BeginTime="0:0:0">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="HeaderPanel"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="20" To="0" Duration="0:0:0.5"
                BeginTime="0:0:0">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="MetricsPanel"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.4"
                BeginTime="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="MetricsPanel"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="24" To="0" Duration="0:0:0.5"
                BeginTime="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="Card1"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                From="0.94" To="1" Duration="0:0:0.4"
                BeginTime="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="Card1"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.94" To="1" Duration="0:0:0.4"
                BeginTime="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="Card2"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                From="0.94" To="1" Duration="0:0:0.4"
                BeginTime="0:0:0.23">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="Card2"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.94" To="1" Duration="0:0:0.4"
                BeginTime="0:0:0.23">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="Card3"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                From="0.94" To="1" Duration="0:0:0.4"
                BeginTime="0:0:0.31">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="Card3"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.94" To="1" Duration="0:0:0.4"
                BeginTime="0:0:0.31">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="DetailsPanel"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.4"
                BeginTime="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="DetailsPanel"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="20" To="0" Duration="0:0:0.5"
                BeginTime="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="ExitStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="HeaderPanel"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="HeaderPanel"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                To="-12" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="MetricsPanel"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="MetricsPanel"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                To="-12" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="DetailsPanel"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="DetailsPanel"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                To="-12" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid Background="Transparent">
        <Border x:Name="RootHost">
            <Grid
                x:Name="LayoutRoot"
                Width="1100"
                MaxWidth="1100"
                Padding="32,20,32,20"
                RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="HeaderPanel"
                    ColumnSpacing="16"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform Y="20" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                x:Name="TitleText"
                                FontSize="34"
                                FontWeight="Bold"
                                Text="硬件信息"
                                IsTapEnabled="True"
                                Tapped="TitleText_Tapped" />
                            <Border
                                x:Name="CpuzBadge"
                                Visibility="Collapsed"
                                Padding="8,2"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                Margin="0,6,0,0">
                                <Border.Background>
                                    <SolidColorBrush Color="#2600C864" />
                                </Border.Background>
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#FF00C864"
                                    Text="CPU-Z" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            FontSize="16"
                            Opacity="1.0"
                            Text="汇总本机型号、系统和关键硬件参数。" />
                    </StackPanel>

                    <StackPanel x:Name="HeaderButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8">

                        <Button
                            Padding="16,8"
                            Click="DetailButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE946;" />
                                <TextBlock FontSize="16" Text="详细信息" />
                            </StackPanel>
                        </Button>
                        <Button
                            Padding="16,8"
                            Click="RefreshButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="RefreshIcon" FontSize="16" Glyph="&#xE72C;" />
                                <TextBlock FontSize="16" Text="刷新" />
                            </StackPanel>
                        </Button>
                        <DropDownButton
                            Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE8B9;" />
                                <TextBlock FontSize="16" Text="分享" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="截图" Click="ScreenshotButton_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontSize="16" Glyph="&#xE8B9;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="复制纯文字" Click="CopyTextButton_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="复制 Markdown" Click="CopyMarkdownButton_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontSize="16" Glyph="&#xE943;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                </Grid>

                <Grid
                    x:Name="MetricsPanel"
                    Grid.Row="1"
                    ColumnSpacing="14"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform Y="24" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="Card1" Style="{StaticResource MetricCardStyle}" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" Tapped="Card1_Tapped" IsTapEnabled="True" ToolTipService.ToolTip="点击复制">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="48"
                                Height="48"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <FontIcon FontSize="24" Glyph="&#xE772;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock FontSize="15" Opacity="1.0" Text="型号信息" />
                                <TextBlock
                                    x:Name="ModelText"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="Card2" Grid.Column="1" Style="{StaticResource MetricCardStyle}" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" Tapped="Card2_Tapped" IsTapEnabled="True" ToolTipService.ToolTip="点击复制">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="48"
                                Height="48"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <FontIcon FontSize="24" Glyph="&#xE770;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock FontSize="15" Opacity="1.0" Text="系统信息" />
                                <TextBlock
                                    x:Name="SystemText"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="Card3" Grid.Column="2" Style="{StaticResource MetricCardStyle}" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" Tapped="Card3_Tapped" IsTapEnabled="True" ToolTipService.ToolTip="点击复制">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="48"
                                Height="48"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <FontIcon FontSize="24" Glyph="&#xE917;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock FontSize="15" Opacity="1.0" Text="运行时间" />
                                <TextBlock
                                    x:Name="UptimeText"
                                    Width="220"
                                    HorizontalAlignment="Left"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel
                    x:Name="DetailsPanel"
                    Grid.Row="2"
                    Spacing="8"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform Y="20" />
                    </StackPanel.RenderTransform>
                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Text="详细信息" />

                    <Border
                        Padding="16"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <ItemsRepeater x:Name="DetailsRepeater" ElementPrepared="DetailsRepeater_ElementPrepared">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="16,9"
                                        ColumnSpacing="14"
                                        PointerPressed="DetailItem_PointerPressed"
                                        IsTapEnabled="True"
                                        Tapped="DetailItem_Tapped"
                                        ToolTipService.ToolTip="点击复制">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock

                                            FontSize="15"
                                            Opacity="1.0"
                                            Text="{Binding Label}"
                                            VerticalAlignment="Center" />
                                        <Border
                                            Grid.Column="1"
                                            Width="1"
                                            Height="16"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            x:Name="ValueText"

                                            Grid.Column="2"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Text="{Binding Value}"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center"
                                            RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <Border
                                            x:Name="VerifiedBadge"
                                            Grid.Column="3"
                                            Padding="6,1"
                                            CornerRadius="3"
                                            Visibility="Collapsed"
                                            VerticalAlignment="Center">
                                            <Border.Background>
                                                <SolidColorBrush Color="#2600C864" />
                                            </Border.Background>
                                            <TextBlock

                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="#FF00C864"
                                                Text="真" />
                                        </Border>
                                        <Image
                                            Grid.Column="4"
                                            Width="20"
                                            Height="20"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Stretch="Uniform"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressRing
            x:Name="LoadingRing"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False"
            Visibility="Collapsed" />

        <InfoBar
            x:Name="StatusBar"
            Margin="28"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Page>
