<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.ServiceCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="20,20,20,12" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8">
                <FontIcon FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE80F;" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock FontSize="20" FontWeight="Bold" Text="服务网点查询" />
                <TextBlock FontSize="12" Opacity="0.7" Text="查询各大品牌官方服务网点与售后支持" />
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="2" Click="BackButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    <TextBlock Text="返回" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <ScrollView HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavPanel" Spacing="4" Padding="12,8,12,12">
                        <Expander x:Name="LaptopExpander" Header="笔记本" IsExpanded="True" HorizontalAlignment="Stretch">
                            <Expander.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE770;" FontSize="14" />
                                        <TextBlock FontWeight="Bold" Text="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </Expander.HeaderTemplate>
                            <StackPanel x:Name="LaptopList" Spacing="2" />
                        </Expander>

                        <Expander x:Name="DesktopExpander" Header="台式机/品牌机" IsExpanded="True" HorizontalAlignment="Stretch">
                            <Expander.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE774;" FontSize="14" />
                                        <TextBlock FontWeight="Bold" Text="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </Expander.HeaderTemplate>
                            <StackPanel x:Name="DesktopList" Spacing="2" />
                        </Expander>

                        <Expander x:Name="AccessoryExpander" Header="配件/外设" IsExpanded="True" HorizontalAlignment="Stretch">
                            <Expander.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7FD;" FontSize="14" />
                                        <TextBlock FontWeight="Bold" Text="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </Expander.HeaderTemplate>
                            <StackPanel x:Name="AccessoryList" Spacing="2" />
                        </Expander>
                    </StackPanel>
                </ScrollView>
            </Grid>

            <Border Grid.Column="1" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="UrlBar" Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE71B;" FontSize="14" Opacity="0.6" />
                        <TextBlock x:Name="UrlText" Grid.Column="1" FontSize="12" Opacity="0.7" Text="请从左侧选择品牌" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <HyperlinkButton x:Name="OpenExternalBtn" Grid.Column="2" Click="OpenExternalBtn_Click" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE7A6;" FontSize="12" />
                                <TextBlock FontSize="12" Text="在新窗口打开" />
                            </StackPanel>
                        </HyperlinkButton>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <WebView2 x:Name="WebView" Source="about:blank" Visibility="Collapsed" />
                    
                    <Grid x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.OpacityTransition>
                            <ScalarTransition />
                        </Grid.OpacityTransition>
                        <StackPanel Spacing="16">
                            <FontIcon Glyph="&#xE80F;" FontSize="64" Opacity="0.3" />
                            <TextBlock FontSize="15" Opacity="0.6" Text="选择左侧品牌查看服务网点" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    
                    <Grid x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Opacity="0">
                        <Grid.OpacityTransition>
                            <ScalarTransition />
                        </Grid.OpacityTransition>
                        <StackPanel Spacing="12">
                            <ProgressRing Width="40" Height="40" IsActive="True" />
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="LoadingBrandText" FontSize="14" Opacity="0.8" TextAlignment="Center" />
                                <TextBlock FontSize="12" Opacity="0.5" Text="正在加载服务网点..." TextAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>