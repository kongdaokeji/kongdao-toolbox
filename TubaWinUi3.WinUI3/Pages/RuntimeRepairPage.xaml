<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.RuntimeRepairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="RuntimeRepairPage_Loaded"
    Unloaded="RuntimeRepairPage_Unloaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Padding="24,18,24,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10">
                <FontIcon FontSize="19" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE90F;" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="运行库修复" />
                <TextBlock FontSize="12" Opacity="0.85" Text="检测系统运行库与游戏常用 DLL，仅修复缺失或不完整的项目" />
            </StackPanel>
            <Button x:Name="BackButton" Grid.Column="2" Click="BackButton_Click" Padding="10,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    <TextBlock Text="返回" FontSize="13" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 正文 -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto" Padding="24,4,24,24">
            <StackPanel Spacing="14">

                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" Title="运行库修复失败" />
                <InfoBar x:Name="SuccessBar" Severity="Success" IsOpen="False" IsClosable="True" Title="运行库修复完成" />

                <!-- ═════════ Visual C++ 2008-2026 ═════════ -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="18,16">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Logo 图标 -->
                            <Border x:Name="VcIconBg" Width="46" Height="46" CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top">
                                <FontIcon x:Name="VcIcon" FontSize="20" Glyph="&#xE950;"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Border>

                            <!-- 中间信息 -->
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Top">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="Microsoft Visual C++ 2008-2026" />
                                <TextBlock x:Name="VcDesc" FontSize="13" Opacity="0.85" Text="检测并修复游戏常用 VC++ x86 和 x64 运行库" />
                                <TextBlock x:Name="VcDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="覆盖 2008、2010、2012、2013 及当前 v14 (2015-2026)；v14 同时校验完整运行时 DLL。" />
                                <TextBlock x:Name="VcMissing" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                           MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                <StackPanel x:Name="VcProgressPanel" Visibility="Collapsed" Spacing="4" Margin="0,6,0,0">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="VcPhaseText" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="VcPctText" Grid.Column="1" FontSize="12"
                                                   FontWeight="SemiBold" Text="0%" />
                                    </Grid>
                                    <ProgressBar x:Name="VcBar" Height="5" Minimum="0" Maximum="100" Value="0" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 右侧状态 + 操作 -->
                            <StackPanel Grid.Column="2" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                    <FontIcon x:Name="VcStatusIcon" FontSize="13" Glyph="&#xE73E;" Visibility="Collapsed" />
                                    <TextBlock x:Name="VcStatusText" FontSize="12" FontWeight="SemiBold" Text="检测中…" />
                                </StackPanel>
                                <Button x:Name="VcRepairButton" Tag="visual-cpp" Click="RepairButton_Click"
                                        MinWidth="112" MinHeight="34" Padding="14,0" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing x:Name="VcBtnSpinner" Width="14" Height="14" IsActive="True"
                                                      Visibility="Collapsed" VerticalAlignment="Center" />
                                        <TextBlock x:Name="VcBtnText" FontSize="13" Text="修复缺失项" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═════════ .NET Framework ═════════ -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="18,16">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="DotNetIconBg" Width="46" Height="46" CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top">
                                <FontIcon x:Name="DotNetIcon" FontSize="20" Glyph="&#xE9E9;"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Top">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text=".NET Framework 4.8.1" />
                                <TextBlock x:Name="DotNetDesc" FontSize="13" Opacity="0.85" Text="修复 Microsoft .NET Framework 4.8.1 Runtime" />
                                <TextBlock x:Name="DotNetDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="使用微软离线 Runtime 安装包，不安装开发者工具包。" />
                                <TextBlock x:Name="DotNetMissing" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                           MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                <StackPanel x:Name="DotNetProgressPanel" Visibility="Collapsed" Spacing="4" Margin="0,6,0,0">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DotNetPhaseText" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="DotNetPctText" Grid.Column="1" FontSize="12"
                                                   FontWeight="SemiBold" Text="0%" />
                                    </Grid>
                                    <ProgressBar x:Name="DotNetBar" Height="5" Minimum="0" Maximum="100" Value="0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                    <FontIcon x:Name="DotNetStatusIcon" FontSize="13" Glyph="&#xE73E;" Visibility="Collapsed" />
                                    <TextBlock x:Name="DotNetStatusText" FontSize="12" FontWeight="SemiBold" Text="检测中…" />
                                </StackPanel>
                                <Button x:Name="DotNetRepairButton" Tag="dotnet" Click="RepairButton_Click"
                                        MinWidth="112" MinHeight="34" Padding="14,0" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing x:Name="DotNetBtnSpinner" Width="14" Height="14" IsActive="True"
                                                      Visibility="Collapsed" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DotNetBtnText" FontSize="13" Text="修复缺失项" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═════════ DirectX 9-12 ═════════ -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="18,16">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="DxIconBg" Width="46" Height="46" CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top">
                                <FontIcon x:Name="DxIcon" FontSize="20" Glyph="&#xE7C4;"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Top">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="DirectX 9-12 游戏组件" />
                                <TextBlock x:Name="DxDesc" FontSize="13" Opacity="0.85" Text="补充旧版 DirectX SDK 兼容组件" />
                                <TextBlock x:Name="DxDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="修复 D3DX、XAudio、XInput 等旧游戏依赖；系统 DirectX 12 由 Windows 更新维护。" />
                                <TextBlock x:Name="DxMissing" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                           MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                <StackPanel x:Name="DxProgressPanel" Visibility="Collapsed" Spacing="4" Margin="0,6,0,0">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DxPhaseText" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="DxPctText" Grid.Column="1" FontSize="12"
                                                   FontWeight="SemiBold" Text="0%" />
                                    </Grid>
                                    <ProgressBar x:Name="DxBar" Height="5" Minimum="0" Maximum="100" Value="0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                    <FontIcon x:Name="DxStatusIcon" FontSize="13" Glyph="&#xE73E;" Visibility="Collapsed" />
                                    <TextBlock x:Name="DxStatusText" FontSize="12" FontWeight="SemiBold" Text="检测中…" />
                                </StackPanel>
                                <Button x:Name="DxRepairButton" Tag="directx" Click="RepairButton_Click"
                                        MinWidth="112" MinHeight="34" Padding="14,0" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing x:Name="DxBtnSpinner" Width="14" Height="14" IsActive="True"
                                                      Visibility="Collapsed" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DxBtnText" FontSize="13" Text="修复缺失项" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock FontSize="12" Opacity="0.7" Text="安装过程可能需要网络连接，完成后按系统提示重启。" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>