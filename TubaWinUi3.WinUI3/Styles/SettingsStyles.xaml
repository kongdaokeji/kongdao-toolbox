<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        设置页共享样式：统一基于 FluentTokens.xaml 中的令牌。
        SectionHeaderStyle 已迁移至 FluentTokens.xaml。
    -->

    <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource FluentCardStyle}" />

    <Style x:Key="IconBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="NavCardBorderStyle" TargetType="Border" BasedOn="{StaticResource FluentCardStyle}" />

    <Style x:Key="NavCardIconBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

</ResourceDictionary>
