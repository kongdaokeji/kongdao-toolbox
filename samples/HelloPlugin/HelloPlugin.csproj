<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <PackageId>KongdaoTools.Hello</PackageId>
    <Version>2.1.0</Version>
    <Authors>YourName</Authors>
    <Description>图吧工具箱插件开发示例</Description>
    <PackageTags>KongdaoTools</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../KongdaoToolbox.PluginSdk/KongdaoToolbox.PluginSdk.csproj" Private="false" PrivateAssets="all" />
    <None Include="assets/icon.svg" Pack="true" PackagePath="assets/" />
    <None Include="kongdaotools.json" Pack="true" PackagePath="/" />
    <None Include="$(OutputPath)HelloPlugin.dll" Pack="true" PackagePath="plugin/" />
    <None Include="$(OutputPath)HelloPlugin.deps.json" Pack="true" PackagePath="plugin/" />
  </ItemGroup>
</Project>
