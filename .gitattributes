# 根级 .gitattributes —— 图吧工具箱 TubaWinUi3
# 统一行尾与二进制文件声明，避免跨平台（Windows 开发 / CI ubuntu/ARM）出现假 diff

# 默认：文本文件启用自动换行转换，仓库内统一 LF，检出到工作区按平台（Windows=CRLF）
* text=auto

# ---------------- 文本文件：显式声明 ----------------
*.cs       text eol=crlf
*.xaml     text eol=crlf
*.xaml.cs  text eol=crlf
*.csproj   text eol=crlf
*.sln      text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.xml      text eol=crlf
*.config   text eol=crlf
*.json     text eol=crlf
*.md       text eol=crlf
*.ps1      text eol=crlf
*.psm1     text eol=crlf
*.iss      text eol=crlf
*.py       text eol=crlf
*.yml      text eol=crlf
*.yaml     text eol=crlf
*.sh       text eol=lf
*.bat      text eol=crlf
*.cmd      text eol=crlf

# ---------------- 二进制文件：禁止文本转换 ----------------
*.exe     binary
*.dll     binary
*.sys     binary
*.bin     binary
*.pri     binary
*.pdb     binary
*.pfx     binary
*.cer     binary
*.zip     binary
*.7z      binary
*.lzma    binary
*.gz      binary
*.tar     binary
*.rar     binary
*.iso     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.bmp     binary
*.webp    binary
*.icns    binary
*.otf     binary
*.ttf     binary
*.woff    binary
*.woff2   binary
*.eot     binary
*.mdb     binary
*.db      binary
*.sqlite  binary
*.dat     binary
*.pak     binary
*.upk     binary
*.unity3d binary
*.resx    binary

# ---------------- 生成产物 / 大目录忽略（配合 .gitignore） ----------------
/.zcode/     export-ignore
/dist/       export-ignore
/node_modules/ export-ignore
